{
  "rMAP.input_reads": [
    "/data/fastq/sample1_R1.fastq.gz",
    "/data/fastq/sample1_R2.fastq.gz"
  ],

  "rMAP.reference_genome": "/data/reference/Klebsiella_pneumoniae_MGH78578.gbk",
  "rMAP.reference_type": "genbank",

  "rMAP.do_trimming": true,
  "rMAP.do_quality_control": true,
  "rMAP.do_assembly": true,
  "rMAP.do_annotation": true,
  "rMAP.do_variant_calling": true,
  "rMAP.do_mlst": true,
  "rMAP.do_amr_profiling": true,
  "rMAP.do_virulence_analysis": true,
  "rMAP.do_mge_analysis": true,
  "rMAP.do_blast": true,
  "rMAP.do_pangenome": false,
  "rMAP.do_phylogeny": false,

  "rMAP.local_amr_db": "/data/databases/resfinder",
  "rMAP.local_virulence_db": "/data/databases/vfdb",
  "rMAP.local_plasmid_db": "/data/databases/plasmidfinder",
  "rMAP.local_blast_db": "/data/databases/eskapee_db",

  "rMAP.abricate_min_identity": 90,
  "rMAP.abricate_min_coverage": 80,

  "rMAP.max_cpus": 8,
  "rMAP.max_memory_gb": 16
}
